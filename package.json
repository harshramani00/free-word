{
  "name": "quill",
  "productName": "Quill",
  "version": "0.1.1",
  "description": "Quill \u2014 a free Word alternative for macOS. Writes real .docx files, exports PDF, no cloud, no AI.",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Harsh Ramani",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "@fontsource/source-serif-4": "^5.3.1",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-subscript": "^3.31.4",
    "@tiptap/extension-superscript": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/html": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@xmldom/xmldom": "^0.9.12",
    "docx": "^9.10.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.14.6",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "homepage": "https://github.com/harshramani00/quill",
  "repository": {
    "type": "git",
    "url": "https://github.com/harshramani00/quill.git"
  }
}
