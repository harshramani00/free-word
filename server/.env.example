# Quill Cloud server configuration. Copy to .env and fill in.

# Public address of this server (what Quill and Claude connect to). With Tailscale Funnel:
ISSUER=https://quill.your-tailnet.ts.net
# Local port the service listens on (Funnel forwards to it). Keep it on 127.0.0.1.
PORT=8787
HOST=127.0.0.1

# Where the database, document versions and the signing key live.
DATA_DIR=C:\quill-data

# Google sign-in: an OAuth client of type "Web application" from console.cloud.google.com,
# with the authorised redirect URI  <ISSUER>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may create an account (comma-separated emails). Empty means anyone with a Google account.
ALLOWED_EMAILS=you@example.com,friend@example.com

# Per-person storage cap in bytes (default 5 GB) and versions kept per document (default 30).
# QUOTA_BYTES=5368709120
# KEEP_VERSIONS=30

# Local trial without Google (only allowed when ISSUER is 127.0.0.1): QUILL_DEV_LOGIN=1
